# Texto normalizado a LF en el repo; en el working tree sigue core.autocrlf / .editorconfig (CRLF en Windows).
* text=auto

# Scripts de Windows y soluciones: siempre CRLF al hacer checkout
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binarios: no tocar
*.png binary
*.jpg binary
*.ico binary
*.pfx binary
*.cer binary
*.zip binary
*.db binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
