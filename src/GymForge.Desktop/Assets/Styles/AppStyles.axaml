<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls"
        xmlns:ctl="using:GymForge.Desktop.Controls">

    <!-- ════════════════════════════════════════════════════════════════════
         Design system GymForge — clases opt-in.
         Lenguaje: cards flotantes (radio 14, sombra suave) sobre lienzo gris,
         acento indigo de marca con tintes al ~14%, pills de estado redondeadas.
         Los colores semánticos viven en Colors.axaml (light/dark).
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ── Superficies ── -->
    <!-- Card: borde hairline + sombra multicapa (ambiental + contacto) para dar
         profundidad creíble. En dark la sombra casi no se ve y el borde define la card. -->
    <Style Selector="Border.Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22,18" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 1 2 0 #14000000, 0 10 26 -8 #1F000000" />
    </Style>

    <!-- Card clicable: cursor de mano + eleva y resalta el borde al pasar el mouse -->
    <Style Selector="Border.Card.Interactive">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.Card.Interactive:pointerover">
        <Setter Property="BoxShadow" Value="0 2 4 0 #1A000000, 0 16 34 -10 #2E000000" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}" />
    </Style>

    <!-- Barra superior de cada vista: fondo de card + borde inferior -->
    <Style Selector="Border.Toolbar">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.FooterBar">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- Divisor horizontal de 1 px dentro de una card (separa bloques de una misma sección) -->
    <Style Selector="Border.Divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" />
    </Style>

    <!-- Panel hundido dentro de una card: agrupa un bloque (cuadro de ayuda, un ítem editable de una lista)
         sin sumar otra sombra. Fondo sutil + hairline, para que se defina igual en light y en dark. -->
    <Style Selector="Border.Inset">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Teclado numérico en pantalla (ctl:NumericKeypad). Classes="NoDisplay" le oculta el visor propio: se usa cuando
         el campo de texto que edita ya está al lado y muestra el valor (kiosk), para no repetirlo ni gastar alto. -->
    <Style Selector="ctl|NumericKeypad.NoDisplay Border#KeypadDisplay">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Chip cuadrado con tinte para el ícono de un KPI o sección -->
    <Style Selector="Border.IconChip">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>

    <!-- Avatar circular con iniciales -->
    <Style Selector="Border.Avatar">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="Border.Avatar > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ── Tipografía ── -->
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.ToolbarTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style Selector="TextBlock.FormLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- KPI de una card: etiqueta (secundario, AA) + cifra grande. Mismo tamaño que las cards del Dashboard
         (13 / 30 bold); la cifra es tabular, igual que Numeric. -->
    <Style Selector="TextBlock.KpiLabel">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.KpiValue">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- Cifras tabulares: montos y KPIs alinean en columnas y no "bailan" al cambiar.
         FontFeatures se hereda a los Run hijos, así que sirve para textos con $ + Run. -->
    <Style Selector="TextBlock.Numeric">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- Valores técnicos que se copian o se tipean tal cual (claves, rutas, {placeholders}) -->
    <Style Selector="TextBlock.Mono">
        <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Courier New" />
    </Style>
    <Style Selector="TextBox.Mono">
        <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,Courier New" />
    </Style>

    <!-- Texto con tono semántico sobre card (light y dark, contraste AA). Se prende con
         Classes.success / Classes.warning / Classes.danger. Van DESPUÉS de FormLabel a propósito:
         a igual especificidad gana el último, así que el tono pisa el color secundario.
         No usar colores literales ni Opacity para esto. -->
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- danger usa DangerTextBrush (no DangerBrush): en dark DangerBrush sobre la card da ≈4,1:1 -->
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <!-- Resultado de una acción bajo un formulario ("Datos guardados.", "PIN incorrecto.").
         Éxito = success, error = danger. Reemplaza al verde/rojo literal de los antiguos converters de color
         (#3F9C49 / #E05252: ~3,5:1, no llega a AA ni en light ni en dark). -->
    <Style Selector="TextBlock.Feedback">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ── Pills de estado ── -->
    <Style Selector="Border.Pill">
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.Pill > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.Pill.success">
        <Setter Property="Background" Value="{DynamicResource SuccessTintBrush}" />
    </Style>
    <Style Selector="Border.Pill.success > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.Pill.warning">
        <Setter Property="Background" Value="{DynamicResource WarningTintBrush}" />
    </Style>
    <Style Selector="Border.Pill.warning > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.Pill.danger">
        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
    </Style>
    <!-- El texto del pill danger usa DangerTextBrush (no DangerBrush): sobre su propio tinte DangerBrush daba
         ≈4,0:1 en light y ≈3,6:1 en dark (< AA a 11 px); DangerTextBrush da ≈5,4:1 y ≈5,3:1 (UX6). -->
    <Style Selector="Border.Pill.danger > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Border.Pill.info">
        <Setter Property="Background" Value="{DynamicResource InfoTintBrush}" />
    </Style>
    <Style Selector="Border.Pill.info > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>
    <Style Selector="Border.Pill.neutral">
        <Setter Property="Background" Value="{DynamicResource NeutralTintBrush}" />
    </Style>
    <Style Selector="Border.Pill.neutral > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource NeutralBrush}" />
    </Style>
    <Style Selector="Border.Pill.accent">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="Border.Pill.accent > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Contador junto a un título (p.ej. "Planes [12]") -->
    <Style Selector="Border.CountBadge">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Border.CountBadge > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Medidor de uso (cupo del plan, días de congelamiento). "warning" = se pasó del tope -->
    <Style Selector="ProgressBar.warning">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>

    <!-- ── Botones ── -->
    <!-- Texto sobre el acento: AccentForegroundBrush (blanco, o casi negro si el acento del gimnasio es claro) -->
    <Style Selector="Button.Primary">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.Primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark1}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.Primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorDark2}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <!-- Deshabilitado (UX3): tinte de acento + texto de acento legible (AA por construcción), en vez de la
         plantilla Fluent que lo deja casi invisible. Más específico que :pointerover, así que no se "prende" al pasar el mouse. -->
    <Style Selector="Button.Primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <Style Selector="Button.Secondary">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style Selector="Button.Danger">
        <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.Danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerFillHoverBrush}" />
        <Setter Property="TextBlock.Foreground" Value="White" />
    </Style>

    <!-- Botón silencioso de toolbar (ícono o texto corto) -->
    <Style Selector="Button.Ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.Ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.Ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <!-- ── Estados vacíos ── -->
    <Style Selector="StackPanel.EmptyState">
        <Setter Property="Spacing" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.EmptyState fa|SymbolIcon">
        <Setter Property="FontSize" Value="44" />
        <!-- Ícono decorativo: terciario (≈3,3:1 en light, ≈3,6:1 en dark; basta para no-texto) en vez de Opacity -->
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.EmptyTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- Texto de apoyo del estado vacío: explica qué hacer, así que va en el secundario (AA ≈6:1).
         El terciario daba ≈3,3:1 (UX21 b). La jerarquía con el título la dan el tamaño y el peso. -->
    <Style Selector="TextBlock.EmptyBody">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Encabezado de grupo del sidebar (se oculta al colapsar) -->
    <Style Selector="TextBlock.NavSection">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="Margin" Value="12,16,12,4" />
    </Style>

    <!-- ── Navigation buttons (sidebar) ── -->
    <Style Selector="Button.NavButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Height" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.NavButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="Button.NavButton:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
    </Style>

    <!-- Active nav button — tinte de acento del gimnasio + hairline de acento (el tinte solo al 12% quedaba flojo)
         + texto de acento legible (AccentTextBrush). El borde es decorativo: el texto no depende de él. -->
    <Style Selector="Button.NavButton.active /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorLight2}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.NavButton.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <!-- Más específico que el borde de arriba: el anillo de teclado no se pierde en el ítem activo -->
    <Style Selector="Button.NavButton.active:focus-visible /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.NavButton.active">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ── Icon-only buttons ── -->
    <Style Selector="Button.IconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.IconButton:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- ── Search / command palette button ── -->
    <Style Selector="Button.SearchButton">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinWidth" Value="260" />
    </Style>

    <!-- ── Swatch de color (paleta de acento) ── -->
    <!-- Conserva su color de fondo en hover/pressed (el template Fluent lo pisaría). -->
    <Style Selector="Button.Swatch">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.Swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    </Style>
    <Style Selector="Button.Swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    </Style>
    <!-- Swatch seleccionado: anillo de acento -->
    <Style Selector="Button.Swatch.selected">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- ── DataGrid ── -->
    <!-- Cifras tabulares en toda la grilla: las columnas de montos alinean. -->
    <Style Selector="DataGrid">
        <Setter Property="RowHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="(TextElement.FontFeatures)" Value="+tnum" />
    </Style>
    <!-- Selección de fila (UX17): las acciones de las grillas son por botón, no por selección. Fluent pinta la fila
         con el acento al ~70% y arruina los pills; acá queda un relleno sutil neutro, igual en light y dark. -->
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:pointerover:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ── Modales ── -->
    <!-- Card de un modal (y del command palette): borde hairline (en dark la sombra no se ve y el borde define la
         card), radio 12, padding 24 y sombra más profunda que la de Border.Card porque flota sobre el scrim. -->
    <Style Selector="Border.ModalCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="BoxShadow" Value="0 8 32 0 #44000000" />
    </Style>

    <!-- Host común de modal: scrim + scroll de reserva (ventana baja) + card centrada. Foco/Tab: ver ctl:ModalHost. -->
    <Style Selector="ctl|ModalHost">
        <Setter Property="ZIndex" Value="100" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{DynamicResource ScrimBrush}">
                    <ScrollViewer Padding="{TemplateBinding Padding}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Classes="ModalCard" Margin="24"
                                MaxWidth="{TemplateBinding CardMaxWidth}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                KeyboardNavigation.TabNavigation="Cycle">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ScrollViewer>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ── Estados de botones coherentes: transición corta (≤160 ms) y foco visible ── -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Anillo de foco de teclado (no aparece al hacer click): trazo de texto primario, visible en light y dark
         sobre cualquier fondo de botón. -->
    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

</Styles>
