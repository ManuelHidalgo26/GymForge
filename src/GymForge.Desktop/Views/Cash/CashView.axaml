<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Cash"
             xmlns:dto="using:GymForge.Application.DTOs"
             xmlns:ctl="using:GymForge.Desktop.Controls"
             x:Class="GymForge.Desktop.Views.Cash.CashView"
             x:DataType="vm:CashViewModel">

    <Grid RowDefinitions="Auto,*" Name="Root">

        <!-- ── Toolbar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Classes="Toolbar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10">
                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Calculator}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Caja" Classes="ToolbarTitle" />
                </StackPanel>

                <!-- Último hijo del DockPanel: llena el resto, así que se alinea a la derecha -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding Session.IsSignedIn}">
                    <TextBlock VerticalAlignment="Center" FontSize="13">
                        <Run Text="Cajero: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding Session.CashierName}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Command="{Binding SignOutCommand}" Classes="Ghost" ToolTip.Tip="Cerrar sesión de cajero">
                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Clear}" FontSize="16" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Body ───────────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Center">

                <!-- Status / error ("PIN incorrecto.", etc.). DangerTextBrush y no DangerBrush: sobre el tinte, en dark,
                     DangerBrush no llega a AA. Con LiveSetting para que el lector de pantalla lo anuncie. -->
                <Border IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                        CornerRadius="8" Padding="12,8"
                        Background="{DynamicResource DangerTintBrush}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <!-- 1) Login cajero: a la izquierda el PIN por teclado físico y "Ingresar"; a la derecha el teclado
                     numérico táctil (con visor: muestra un punto por dígito). Los dos editan el mismo Pin. -->
                <Border IsVisible="{Binding !Session.IsSignedIn}" Classes="Card" Padding="24">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32">
                        <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Iniciar sesión de cajero" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Ingresá tu PIN para operar la caja." Classes="FormLabel" TextWrapping="Wrap" />
                            <TextBlock Text="(admin de ejemplo: 1234)" Classes="FormLabel" TextWrapping="Wrap"
                                       IsVisible="{Binding IsDefaultPinInUse}" />
                            <TextBox Watermark="PIN" PasswordChar="●" MaxLength="8" Width="200"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="PIN del cajero"
                                     Text="{Binding Pin}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Command="{Binding LoginCommand}" Classes="Primary" Width="200"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Center">
                                <TextBlock Text="Ingresar" />
                            </Button>
                        </StackPanel>

                        <!-- El ✓ ingresa (Entered, en el code-behind). Con Mask el visor muestra ●●●● y no el PIN. -->
                        <ctl:NumericKeypad Grid.Column="1" x:Name="PinKeypad" Text="{Binding Pin}" Mask="True" MaxLength="8"
                                           VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 2) Caja cerrada: resultado del último arqueo -->
                <Border IsVisible="{Binding IsShiftClosed}" Classes="Card" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Última caja cerrada" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" TextElement.FontFeatures="+tnum">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Efectivo esperado"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentShift.ExpectedCash, StringFormat={}{0:C}}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Efectivo declarado"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentShift.DeclaredCash, StringFormat={}{0:C}}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Diferencia" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"
                                       Text="{Binding CurrentShift.Difference, StringFormat={}{0:C}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3) Abrir caja -->
                <Border IsVisible="{Binding CanOpenShift}" Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Abrir caja" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Fondo inicial" Classes="FormLabel" />
                                <TextBox Width="200" Text="{Binding OpeningCash}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Command="{Binding OpenShiftCommand}" Classes="Primary" Width="200"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="Abrir caja" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 4) Operación de caja abierta -->
                <StackPanel IsVisible="{Binding HasOpenShift}" Spacing="16">

                    <!-- Resumen / arqueo en vivo -->
                    <Border Classes="Card" Padding="20">
                        <Grid ColumnDefinitions="*,*,*,*" TextElement.FontFeatures="+tnum">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Fondo inicial" Classes="FormLabel" />
                                <TextBlock Text="{Binding CurrentShift.OpeningCash, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Ingresos" Classes="FormLabel" />
                                <TextBlock Text="{Binding CurrentShift.CashIn, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Egresos" Classes="FormLabel" />
                                <TextBlock Text="{Binding CurrentShift.CashOut, StringFormat={}{0:C}}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DangerBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock Text="Esperado" Classes="FormLabel" />
                                <TextBlock Text="{Binding CurrentShift.ExpectedCash, StringFormat={}{0:C}}" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Registrar cobro / venta -->
                    <Button Command="{Binding OpenSaleModalCommand}" Classes="Primary"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Add}" FontSize="16" />
                            <TextBlock Text="Registrar cobro / venta" />
                        </StackPanel>
                    </Button>

                    <!-- Movimientos -->
                    <Border Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Movimientos" FontSize="15" FontWeight="SemiBold" />

                            <TextBlock Text="Sin movimientos en este turno todavía."
                                       Classes="FormLabel"
                                       IsVisible="{Binding HasNoMovements}" />

                            <ItemsControl ItemsSource="{Binding CurrentShift.Movements}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="dto:CashMovementDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource EnumEs}}" Width="90" />
                                            <TextBlock Grid.Column="1" Text="{Binding Notes}"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:C}}" FontWeight="SemiBold" Classes="Numeric" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Height="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />

                            <!-- Agregar movimiento -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Watermark="Monto" Width="140" Text="{Binding MovementAmount}" />
                                <TextBox Watermark="Detalle (opcional)" Width="240" Text="{Binding MovementNotes}" />
                                <Button Command="{Binding AddIncomeCommand}" Classes="Secondary" ToolTip.Tip="Registrar ingreso">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Add}" FontSize="14" />
                                        <TextBlock Text="Ingreso" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddExpenseCommand}" Classes="Secondary" ToolTip.Tip="Registrar egreso">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Remove}" FontSize="14" />
                                        <TextBlock Text="Egreso" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cierre / arqueo -->
                    <Border Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Cerrar caja (arqueo)" FontSize="15" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Watermark="Efectivo contado" Width="180" Text="{Binding DeclaredCash}" />
                                <TextBox Watermark="Notas (opcional)" Width="240" Text="{Binding CloseNotes}" />
                                <Button Command="{Binding CloseShiftCommand}" Classes="Danger">
                                    <TextBlock Text="Cerrar caja" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Modal: registrar cobro / venta ─────────────────────────────── -->
        <!-- El host trae el scroll de reserva: el modal crece con el aviso del lector y los errores, y en una ventana
             baja (1366x768) ya no entra entero. Si entra, se ve centrado y no hay barra. -->
        <ctl:ModalHost Grid.Row="0" Grid.RowSpan="2"
                       IsVisible="{Binding IsSaleModalOpen}"
                       Content="{Binding SaleModal}"
                       AutomationProperties.Name="Registrar cobro o venta" />

    </Grid>

</UserControl>
