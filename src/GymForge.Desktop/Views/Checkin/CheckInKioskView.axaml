<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Checkin"
             xmlns:access="using:GymForge.Application.UseCases.Access"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:ctl="using:GymForge.Desktop.Controls"
             x:Class="GymForge.Desktop.Views.Checkin.CheckInKioskView"
             x:DataType="vm:CheckInKioskViewModel"
             Background="#111113">

    <!-- El kiosk es una superficie oscura FIJA (colores literales): se fuerza el tema oscuro para que el campo de DNI,
         los botones y el teclado no se vean claros sobre el fondo oscuro cuando la app está en tema claro, y para poder
         usar los tokens de texto (TextFillColor*) con contraste AA.
         Contraste (texto sobre #1E1E22 / #0D0D0F / #171719): TextFillColorSecondary ≈ 9:1, TextFillColorTertiary ≈ 5.6:1.
         Sobre los rellenos sólidos verde (#22C55E) y ámbar (#F59E0B) el texto va OSCURO (#052E16 ≈ 6,5:1 y #1C1100 ≈ 8,7:1);
         el blanco daba ≈ 2,3:1 y ≈ 2,1:1. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ── Encabezado de marca del gimnasio ──────────────────────────────── -->
            <Border Grid.Row="0" Padding="24,14" Background="#0D0D0F">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Panel Width="40" Height="40">
                            <Border CornerRadius="9" ClipToBounds="True" IsVisible="{Binding Session.HasLogo}">
                                <Image Source="{Binding Session.LogoImage}" Stretch="UniformToFill" />
                            </Border>
                            <Border CornerRadius="9" Background="{DynamicResource SystemAccentColor}"
                                    IsVisible="{Binding !Session.HasLogo}">
                                <TextBlock Text="{Binding Session.GymInitials}" FontWeight="Bold" FontSize="16"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="{Binding Session.GymName}" Foreground="White"
                                       FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Session.CurrentSite.Name}" Foreground="#888" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="99" Padding="14,6" VerticalAlignment="Center"
                            Background="#1A1A1E">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Permissions}" FontSize="14" Foreground="#AAAAAA" />
                            <TextBlock Text="Control de acceso" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,380">

                <!-- ── Tarjeta central (lo que ve el socio) ──────────────────────── -->
                <!-- Con scroll de reserva: en una ventana baja (1366x768) la tarjeta con el teclado numérico no entra
                     entera, y sin esto la parte de abajo quedaba cortada sin forma de llegar. Entrando, no se ve. -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- MaxWidth + Stretch (en vez de Width fijo): con la ventana en su mínimo la tarjeta se angosta en lugar de cortarse -->
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24,12"
                            MaxWidth="420" MinHeight="440" CornerRadius="20" Padding="32"
                            Background="#1E1E22" BoxShadow="0 8 40 0 #88000000">

                        <!-- MinHeight + centrado vertical: la tarjeta no "salta" de alto al pasar de reposo a verificando/resultado -->
                        <StackPanel Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- IDLE: tarjeta/DNI en un renglón y el teclado debajo (alto total ≈ 500 px) -->
                            <StackPanel IsVisible="{Binding IsIdle}" Width="284" Spacing="14" HorizontalAlignment="Center">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border Width="44" Height="44" CornerRadius="12" Background="#2A2A30" VerticalAlignment="Center">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Contact}" FontSize="24" Foreground="#CCCCCC"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Acercá tu tarjeta o ingresá tu DNI"
                                               FontSize="16" Foreground="#CCCCCC" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>

                                <TextBox x:Name="DniInput" Text="{Binding CredentialInput}"
                                         Watermark="DNI / Número de socio"
                                         FontSize="22" TextAlignment="Center"
                                         Background="#2A2A30" Foreground="White"
                                         CornerRadius="10" Padding="16,10"
                                         AutomationProperties.Name="DNI o número de socio" />

                                <Button Content="Ingresar" Command="{Binding ManualCheckInCommand}" Classes="Primary"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        FontSize="18" FontWeight="SemiBold" Height="48" CornerRadius="10" />

                                <!-- Teclado táctil: edita el mismo DNI que el campo (que ya hace de visor, por eso NoDisplay);
                                     el ✓ ingresa (Entered, en el code-behind). Las teclas no roban el foco del campo. -->
                                <ctl:NumericKeypad x:Name="DniKeypad" Classes="NoDisplay"
                                                   Text="{Binding CredentialInput}" MaxLength="12" />
                            </StackPanel>

                            <!-- CHECKING -->
                            <StackPanel IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal},
                                                    ConverterParameter={x:Static vm:KioskState.Checking}}"
                                        HorizontalAlignment="Center" Spacing="16">
                                <fa:ProgressRing Width="64" Height="64" Foreground="White" />
                                <TextBlock Text="Verificando..." FontSize="20" Foreground="White" TextAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <!-- GRANTED -->
                            <StackPanel IsVisible="{Binding IsGranted}" Spacing="16" HorizontalAlignment="Center">
                                <Border Width="160" Height="160" CornerRadius="80" ClipToBounds="True"
                                        HorizontalAlignment="Center" Background="#2A2A30"
                                        BorderBrush="#22C55E" BorderThickness="4"
                                        BoxShadow="0 0 32 0 #6622C55E">
                                    <Panel>
                                        <Image Source="{Binding MemberPhoto}"
                                               IsVisible="{Binding MemberPhoto, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Stretch="UniformToFill" />
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Contact}" FontSize="80" Opacity="0.4" Foreground="White"
                                                       IsVisible="{Binding MemberPhoto, Converter={x:Static ObjectConverters.IsNull}}" />
                                    </Panel>
                                </Border>

                                <TextBlock Text="{Binding MemberName}" FontSize="42" FontWeight="Bold"
                                           Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="356" />

                                <Border CornerRadius="12" Padding="20,10" HorizontalAlignment="Center" Background="#22C55E">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Checkmark}" FontSize="28" Foreground="#052E16" />
                                        <TextBlock Text="ACCESO PERMITIDO" FontSize="22" FontWeight="Bold"
                                                   Foreground="#052E16" VerticalAlignment="Center"
                                                   AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Border>

                                <Border CornerRadius="10" Padding="14,8" HorizontalAlignment="Center"
                                        Background="#F59E0B" IsVisible="{Binding HasDebtWarning}">
                                    <TextBlock FontSize="15" Foreground="#1C1100" TextAlignment="Center" Classes="Numeric">
                                        <Run Text="⚠ Deuda: $" />
                                        <Run Text="{Binding OutstandingAmount, StringFormat='{}{0:N0}'}" FontWeight="Bold" />
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="{Binding LastAccessTime, StringFormat='Ingreso registrado: {0}'}"
                                           FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center" />

                                <TextBlock FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center">
                                    <Run Text="Cierra en " />
                                    <Run Text="{Binding CountdownSeconds}" FontWeight="Bold" Foreground="White" />
                                    <Run Text="s" />
                                </TextBlock>
                            </StackPanel>

                            <!-- DENIED -->
                            <StackPanel IsVisible="{Binding IsDenied}" Spacing="16" HorizontalAlignment="Center">

                                <!-- Quién intentó entrar: con foto si el socio quedó identificado (membresía vencida, deuda, etc.),
                                     así recepción lo reconoce; si el código no es de nadie, solo la cruz. -->
                                <Panel HorizontalAlignment="Center">
                                    <Border Width="128" Height="128" CornerRadius="64" ClipToBounds="True"
                                            Background="#2A2A30" BorderBrush="#EF4444" BorderThickness="4"
                                            IsVisible="{Binding MemberPhoto, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Image Source="{Binding MemberPhoto}" Stretch="UniformToFill" />
                                    </Border>
                                    <Border Width="100" Height="100" CornerRadius="50" Background="#EF4444"
                                            IsVisible="{Binding MemberPhoto, Converter={x:Static ObjectConverters.IsNull}}">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Dismiss}" FontSize="56" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#EF4444"
                                            BorderBrush="#1E1E22" BorderThickness="3"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            IsVisible="{Binding MemberPhoto, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Dismiss}" FontSize="16" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Panel>

                                <TextBlock Text="{Binding MemberName}" FontSize="30" FontWeight="Bold"
                                           Foreground="White" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="356"
                                           IsVisible="{Binding MemberName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                <TextBlock Text="ACCESO DENEGADO" FontSize="28" FontWeight="Bold"
                                           Foreground="#EF4444" TextAlignment="Center"
                                           AutomationProperties.LiveSetting="Assertive" />

                                <TextBlock Text="{Binding DenialMessage}" FontSize="18"
                                           Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />

                                <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextAlignment="Center">
                                    <Run Text="Cierra en " />
                                    <Run Text="{Binding CountdownSeconds}" FontWeight="Bold" Foreground="White" />
                                    <Run Text="s" />
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ── Panel: accesos de hoy ─────────────────────────────────────── -->
                <Border Grid.Column="1" Background="#171719" Padding="20,16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Accesos de hoy"
                                   Foreground="#DDDDDD" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                        <!-- Vacío -->
                        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,40,0,0"
                                    IsVisible="{Binding !HasHistory}" HorizontalAlignment="Center">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.People}" FontSize="40" Opacity="0.25" Foreground="White" />
                            <TextBlock Text="Todavía no hubo ingresos hoy"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer IsVisible="{Binding HasHistory}">
                            <ItemsControl ItemsSource="{Binding TodaysAccess}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="access:AccessLogRowDto">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                                            <!-- Permitido: verde con ícono oscuro (el blanco daba ≈ 2,3:1) -->
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                    VerticalAlignment="Center" Background="#22C55E"
                                                    IsVisible="{Binding Granted}">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Checkmark}" FontSize="18" Foreground="#052E16"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                    VerticalAlignment="Center" Background="#EF4444"
                                                    IsVisible="{Binding !Granted}">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Dismiss}" FontSize="18" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MemberName}" Foreground="White" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="#999" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding At, StringFormat='HH:mm'}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       FontSize="13" VerticalAlignment="Center" Classes="Numeric" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

            </Grid>

            <!-- Barra inferior -->
            <Border Grid.Row="2" Padding="20,12" Background="#0D0D0F">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Session.GymName, StringFormat='{}{0} · Check-in'}"
                               FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="Ghost" Command="{Binding ResetCommand}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            ToolTip.Tip="Vuelve a la pantalla de inicio y cancela la cuenta regresiva">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Refresh}" FontSize="14" />
                            <TextBlock Text="Reiniciar" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </Grid>

    </ThemeVariantScope>
</UserControl>
