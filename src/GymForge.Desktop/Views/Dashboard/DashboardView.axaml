<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Dashboard"
             x:Class="GymForge.Desktop.Views.Dashboard.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <UserControl.Styles>
        <!-- Etiqueta de vencimiento -->
        <Style Selector="TextBlock.when">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.when.urgent">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Margin="28,22" Spacing="16" MaxWidth="1240">

            <!-- ── Header: título + fecha | acciones rápidas ──────────────── -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Spacing="3">
                    <TextBlock Text="Dashboard" Classes="PageTitle" />
                    <TextBlock Text="{Binding TodayLabel}" Classes="PageSubtitle" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="Primary" Command="{Binding QuickCreateMemberCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Add}" FontSize="15" />
                            <TextBlock Text="Nuevo socio" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Command="{Binding QuickCheckInCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Permissions}" FontSize="15" />
                            <TextBlock Text="Check-in" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Button Classes="Secondary" Command="{Binding QuickChargeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Tag}" FontSize="15" />
                            <TextBlock Text="Cobrar" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── KPIs ───────────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid.Styles>
                    <Style Selector="Grid > Border.Card">
                        <Setter Property="Margin" Value="0,0,14,0" />
                    </Style>
                    <Style Selector="Grid > Border.Card:nth-last-child(1)">
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </Grid.Styles>

                <!-- Socios activos -->
                <Border Grid.Column="0" Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="IconChip">
                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.People}" FontSize="18"
                                               Foreground="{DynamicResource SystemAccentColor}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Socios activos" FontSize="13"
                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding TotalActiveMembers}" FontSize="30" FontWeight="Bold" Classes="Numeric" />
                        <TextBlock Text="{Binding MembersSubtitle}" Classes="FormLabel" />
                    </StackPanel>
                </Border>

                <!-- Check-ins -->
                <Border Grid.Column="1" Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="IconChip" Background="{DynamicResource SuccessTintBrush}">
                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Permissions}" FontSize="18"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Check-ins hoy" FontSize="13"
                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding CheckInsToday}" FontSize="30" FontWeight="Bold" Classes="Numeric" />
                        <TextBlock Text="{Binding CheckInsSubtitle}" Classes="FormLabel" />
                    </StackPanel>
                </Border>

                <!-- En mora -->
                <Border Grid.Column="2" Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="IconChip" Background="{DynamicResource WarningTintBrush}">
                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Alert}" FontSize="18"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="En mora" FontSize="13"
                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock Text="{Binding OverdueMembers}" FontSize="30" FontWeight="Bold" Classes="Numeric" />
                        <TextBlock Text="{Binding OverdueSubtitle}" Classes="FormLabel" />
                    </StackPanel>
                </Border>

                <!-- Recaudación -->
                <Border Grid.Column="3" Classes="Card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="IconChip" Background="{DynamicResource SuccessTintBrush}">
                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Tag}" FontSize="18"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Recaudación del mes" FontSize="13"
                                       Margin="11,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <TextBlock FontSize="30" FontWeight="Bold" Classes="Numeric">
                            <Run Text="$" /><Run Text="{Binding RevenueThisMonth, StringFormat={}{0:N0}}" />
                        </TextBlock>
                        <Border Classes="Pill"
                                IsVisible="{Binding HasRevenueTrend}"
                                Classes.success="{Binding RevenueTrendUp}"
                                Classes.danger="{Binding !RevenueTrendUp}">
                            <TextBlock Text="{Binding RevenueTrendText}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Gráfico + listas ───────────────────────────────────────── -->
            <Grid ColumnDefinitions="7*,5*">

                <!-- Recaudación últimos 30 días -->
                <Border Grid.Column="0" Classes="Card" Margin="0,0,14,0" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Recaudación" Classes="SectionTitle" />
                                <TextBlock Text="Últimos 30 días" FontSize="11.5" Classes="FormLabel" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Revenue30DaysTotal}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Right" Classes="Numeric" />
                                <TextBlock Text="Total del período" FontSize="11.5" HorizontalAlignment="Right"
                                           Classes="FormLabel" />
                            </StackPanel>
                        </Grid>

                        <!-- Eje Y + plot. Las etiquetas de monto van en un gutter fijo a la izquierda, FUERA del Viewbox
                             (dentro se deformarían al estirar). Las guías horizontales sí van dentro: son líneas de 1 px en
                             el sistema virtual 300×130 y el estiramiento es solo horizontal.
                             Área + línea de recaudación sobre el Viewbox; barras transparentes encima para los tooltips por día. -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="145,Auto" ColumnSpacing="6" RowSpacing="6">

                            <ItemsControl Grid.Column="0" Width="64" ItemsSource="{Binding AxisTicks}"
                                          AutomationProperties.Name="Eje de montos del gráfico de recaudación">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Height="145" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:AxisTickVm">
                                        <Setter Property="Canvas.Top" Value="{Binding LabelTop}" />
                                        <Setter Property="Width" Value="64" />
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AxisTickVm">
                                        <TextBlock Text="{Binding Label}" Classes="FormLabel Numeric"
                                                   FontSize="10.5" TextAlignment="Right" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Column="1" Grid.Row="0" Margin="0,8,0,7">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="300" Height="130">
                                        <Path Data="{Binding RevenueGuideGeometry}"
                                              Stroke="{DynamicResource SurfaceBorderBrush}"
                                              StrokeThickness="1" />
                                        <Path Data="{Binding RevenueAreaGeometry}"
                                              Fill="{DynamicResource SystemAccentColor}" Opacity="0.95">
                                            <Path.OpacityMask>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Color="#59FFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Path.OpacityMask>
                                        </Path>
                                        <Path Data="{Binding RevenueLineGeometry}"
                                              Stroke="{DynamicResource SystemAccentColor}"
                                              StrokeThickness="1.5"
                                              StrokeLineCap="Round" StrokeJoin="Round" />
                                    </Canvas>
                                </Viewbox>

                                <ItemsControl ItemsSource="{Binding RevenueBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="30" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RevenueBarVm">
                                            <Grid ToolTip.Tip="{Binding Tooltip}" Background="Transparent" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding ChartFromLabel}" Classes="FormLabel" FontSize="10.5" />
                                <TextBlock Grid.Column="1" Text="{Binding ChartToLabel}" Classes="FormLabel" FontSize="10.5" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Columna derecha: vencimientos + actividad -->
                <StackPanel Grid.Column="1" Spacing="14">

                    <!-- Vencen esta semana -->
                    <Border Classes="Card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Vencen esta semana" Classes="SectionTitle" />
                            <TextBlock Text="No hay vencimientos en los próximos 7 días." FontSize="12"
                                       Classes="FormLabel"
                                       IsVisible="{Binding HasNoExpiring}" />
                            <ItemsControl ItemsSource="{Binding ExpiringRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ExpiringRowVm">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                            <Border Classes="Avatar">
                                                <TextBlock Text="{Binding Initials}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding MemberName}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PlanName}" FontSize="11"
                                                           Classes="FormLabel"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="when" Classes.urgent="{Binding IsUrgent}"
                                                       Text="{Binding WhenLabel}" FontSize="11.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Actividad de hoy -->
                    <Border Classes="Card">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Actividad de hoy" Classes="SectionTitle" />
                            <TextBlock Text="Todavía no hubo ingresos hoy." FontSize="12"
                                       Classes="FormLabel"
                                       IsVisible="{Binding HasNoAccess}" />
                            <ItemsControl ItemsSource="{Binding AccessRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AccessRowVm">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4">
                                            <Border Classes="Avatar">
                                                <TextBlock Text="{Binding Initials}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding MemberName}" FontSize="12.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                           Classes.success="{Binding Granted}"
                                                           Classes.danger="{Binding !Granted}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding TimeLabel}" FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>
