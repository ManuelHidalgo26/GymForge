<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:GymForge.Desktop.Controls"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Members"
             xmlns:vmCharges="using:GymForge.Desktop.ViewModels.Charges"
             xmlns:vCharges="using:GymForge.Desktop.Views.Charges"
             xmlns:dto="using:GymForge.Application.DTOs"
             xmlns:enums="using:GymForge.Domain.Enums"
             xmlns:views="using:GymForge.Desktop.Views.Members"
             xmlns:routines="using:GymForge.Desktop.Views.Routines"
             x:Class="GymForge.Desktop.Views.Members.MemberDetailView"
             x:DataType="vm:MemberDetailViewModel">

    <!-- Se quitaron los estilos locales TextBlock.Feedback / Feedback.ok: pisaban los del design system (AppStyles) con
         DangerBrush, que en dark no llega a AA sobre la card. Ahora el resultado usa Feedback + success/danger globales. -->
    <UserControl.Styles>
        <Style Selector="Button.TabButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.TabButton.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="StackPanel.Field">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>
        <!-- Etiqueta: color secundario del tema (AA) en vez de Opacity 0.6 sobre 11 px -->
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.Value">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── Header: avatar + datos básicos + back ────────────────────── -->
        <Border Grid.Row="0" Classes="Toolbar" Padding="20,16">
            <DockPanel>

                <!-- Back button -->
                <Button DockPanel.Dock="Left"
                        Command="{Binding GoBackCommand}"
                        Classes="Ghost" Margin="0,0,12,0"
                        ToolTip.Tip="Volver a la lista">
                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Back}" FontSize="20" />
                </Button>

                <!-- Avatar: la foto del socio si ya tiene (Photo.Preview: la guardada o la recién elegida); si no, la inicial -->
                <Panel DockPanel.Dock="Left" Width="56" Height="56" Margin="0,0,14,0">
                    <Border Classes="Avatar"
                            Width="56" Height="56" CornerRadius="28"
                            IsVisible="{Binding Photo.Preview, Converter={x:Static ObjectConverters.IsNull}}">
                        <TextBlock FontSize="20" FontWeight="Bold"
                                   Text="{Binding Member.FirstName[0]}" />
                    </Border>
                    <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True"
                            IsVisible="{Binding Photo.Preview, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Image Source="{Binding Photo.Preview}" Stretch="UniformToFill"
                               AutomationProperties.Name="Foto del socio" />
                    </Border>
                </Panel>

                <!-- Name + status + meta -->
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding Member.FullName}" />

                        <!-- Estado del socio: pill semántico (tokens light/dark, contraste AA) y en español.
                             StatusTone enciende exactamente una clase de tono según el estado. -->
                        <Border Classes="Pill" Padding="10,4"
                                Classes.success="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=success}"
                                Classes.warning="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=warning}"
                                Classes.danger="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=danger}"
                                Classes.info="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=info}"
                                Classes.accent="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=accent}"
                                Classes.neutral="{Binding Member.Status, Converter={StaticResource StatusTone}, ConverterParameter=neutral}">
                            <TextBlock FontSize="12"
                                       Text="{Binding Member.Status, Converter={StaticResource EnumEs}}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="FormLabel">
                            <Run Text="{Binding Member.DocumentType}" />
                            <Run Text=" " />
                            <Run Text="{Binding Member.DocumentNumber}" />
                        </TextBlock>
                        <TextBlock Classes="FormLabel"
                                   IsVisible="{Binding Member.Email, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding Member.Email}" />
                        <TextBlock Classes="FormLabel"
                                   IsVisible="{Binding Member.Mobile, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Text="{Binding Member.Mobile}" />
                    </StackPanel>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Tab bar ───────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Classes="Toolbar" Padding="0">
            <StackPanel Orientation="Horizontal">

                <Button Content="Datos" Classes="TabButton"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="{x:Static vm:MemberDetailTab.Data}"
                        Classes.active="{Binding ActiveTab,
                            Converter={StaticResource NavSectionActiveConverter},
                            ConverterParameter=Data}" />

                <Button Content="Membresías" Classes="TabButton"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="{x:Static vm:MemberDetailTab.Memberships}"
                        Classes.active="{Binding ActiveTab,
                            Converter={StaticResource NavSectionActiveConverter},
                            ConverterParameter=Memberships}" />

                <Button Content="Cobros" Classes="TabButton"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="{x:Static vm:MemberDetailTab.Charges}"
                        Classes.active="{Binding ActiveTab,
                            Converter={StaticResource NavSectionActiveConverter},
                            ConverterParameter=Charges}" />

                <Button Content="Accesos" Classes="TabButton"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="{x:Static vm:MemberDetailTab.Access}"
                        Classes.active="{Binding ActiveTab,
                            Converter={StaticResource NavSectionActiveConverter},
                            ConverterParameter=Access}" />

                <Button Content="Rutinas" Classes="TabButton"
                        Command="{Binding SwitchTabCommand}"
                        CommandParameter="{x:Static vm:MemberDetailTab.Routines}"
                        Classes.active="{Binding ActiveTab,
                            Converter={StaticResource NavSectionActiveConverter},
                            ConverterParameter=Routines}" />

            </StackPanel>
        </Border>

        <!-- ── Tab content ────────────────────────────────────────────────── -->
        <Grid Grid.Row="2">

            <!-- TAB: Datos personales -->
            <ScrollViewer IsVisible="{Binding ActiveTab,
                Converter={x:Static ObjectConverters.Equal},
                ConverterParameter={x:Static vm:MemberDetailTab.Data}}">
                <StackPanel Margin="24,20" Spacing="16" MaxWidth="700">

                    <!-- Datos personales: card como el resto de la app. El padding de abajo es corto porque cada campo
                         ya trae 16 px de margen inferior. -->
                    <Border Classes="Card" Padding="24,20,24,4"
                            IsVisible="{Binding !Edit.IsEditing}">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <TextBlock Text="Datos personales" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="Secondary" Content="Editar"
                                        Command="{Binding StartEditCommand}"
                                        AutomationProperties.Name="Editar datos del socio" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >

                                <StackPanel Grid.Row="0" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Nombre" />
                                    <TextBlock Classes="Value" Text="{Binding Member.FirstName}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Apellido" />
                                    <TextBlock Classes="Value" Text="{Binding Member.LastName}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Tipo documento" />
                                    <TextBlock Classes="Value" Text="{Binding Member.DocumentType}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Número documento" />
                                    <TextBlock Classes="Value" Text="{Binding Member.DocumentNumber}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Email" />
                                    <TextBlock Classes="Value"
                                               Text="{Binding Member.Email, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Celular" />
                                    <TextBlock Classes="Value"
                                               Text="{Binding Member.Mobile, TargetNullValue='—'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Fecha de nacimiento" />
                                    <TextBlock Classes="Value"
                                               Text="{Binding Member.BirthDate, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Edad" />
                                    <TextBlock Classes="Value"
                                               Text="{Binding Member.Age, TargetNullValue='—'}" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Socio desde" />
                                    <TextBlock Classes="Value"
                                               Text="{Binding Member.JoinDate, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Huella digital" />
                                    <TextBlock Classes="Value" Text="Registrada"
                                               IsVisible="{Binding Member.HasFingerprint}" />
                                    <TextBlock Classes="Value" Text="No registrada"
                                               IsVisible="{Binding !Member.HasFingerprint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Emergencia y salud (solo lectura; se editan con "Editar" de arriba). -->
                    <Border Classes="Card" Padding="24,20,24,4"
                            IsVisible="{Binding !Edit.IsEditing}">
                        <StackPanel>
                            <TextBlock Text="Emergencia y salud" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Contacto de emergencia" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.EmergencyName, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Teléfono de emergencia" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.EmergencyPhone, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Vínculo" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.EmergencyRelation, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Grupo sanguíneo" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.BloodType, Converter={StaticResource EnumEs}}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Condiciones médicas" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.MedicalConditions, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Classes="Field">
                                    <TextBlock Classes="Label" Text="Medicación" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.Medications, TargetNullValue='—'}" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="0" Classes="Field">
                                    <TextBlock Classes="Label" Text="Alergias" />
                                    <TextBlock Classes="Value" TextWrapping="Wrap"
                                               Text="{Binding Member.Allergies, TargetNullValue='—'}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel IsVisible="{Binding Edit.IsEditing}">
                        <views:MemberEditForm DataContext="{Binding Edit}" />
                    </StackPanel>

                    <!-- Foto y credencial, lado a lado. La foto es el mismo componente que usa el alta (PhotoPickerView):
                         se guarda apenas se elige y se ve también en el avatar del encabezado. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">

                        <Border Grid.Column="0" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Foto" FontSize="15" FontWeight="SemiBold" />
                                <views:PhotoPickerView DataContext="{Binding Photo}" />
                            </StackPanel>
                        </Border>

                        <!-- Credencial de acceso: el lector de códigos tipea en el campo y el Enter final la asigna.
                             "Escanear" deja el foco en el campo (code-behind) para que el primer carácter del lector caiga ahí. -->
                        <Border Grid.Column="1" Classes="Card" Padding="24,20" VerticalAlignment="Top">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Credencial de acceso" FontSize="15" FontWeight="SemiBold" />

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="FormLabel" Text="Credencial actual" />
                                    <Border Classes="Inset" HorizontalAlignment="Left" Padding="12,6"
                                            IsVisible="{Binding Member.TagSerial, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <TextBlock Classes="Mono" FontSize="14" FontWeight="SemiBold"
                                                   Text="{Binding Member.TagSerial}" />
                                    </Border>
                                    <TextBlock Classes="FormLabel" FontSize="14" Text="Sin credencial"
                                               IsVisible="{Binding Member.TagSerial, Converter={x:Static ObjectConverters.IsNull}}" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Classes="FormLabel" Text="Nueva credencial" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="CredentialInput" MaxLength="50" Text="{Binding NewCredential}"
                                                 Watermark="Escaneá o escribí el código"
                                                 AutomationProperties.Name="Nueva credencial">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding SaveCredentialCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Classes="Secondary" Click="OnScanCredentialClick"
                                                AutomationProperties.Name="Escanear credencial"
                                                ToolTip.Tip="Hacé clic y pasá el carnet por el lector de códigos">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Scan}" FontSize="15" />
                                                <TextBlock Text="Escanear" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding SaveCredentialCommand}" Classes="Primary" Content="Asignar" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Hacé clic en Escanear y pasá el carnet por el lector: al terminar se asigna solo. También podés escribir el código y presionar Enter." />

                                <TextBlock Classes="Feedback" Classes.success="{Binding CredentialAssigned}"
                                           Classes.danger="{Binding !CredentialAssigned}"
                                           Text="{Binding CredentialMessage}"
                                           IsVisible="{Binding CredentialMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB: Membresías -->
            <Grid IsVisible="{Binding ActiveTab,
                Converter={x:Static ObjectConverters.Equal},
                ConverterParameter={x:Static vm:MemberDetailTab.Memberships}}"
                  RowDefinitions="Auto,*,Auto">

                <fa:InfoBar Grid.Row="0" Margin="16,12,16,0"
                            IsOpen="{Binding MembershipsMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Severity="Error"
                            Title="No se pudo completar la operación"
                            Message="{Binding MembershipsMessage}"
                            IsClosable="False"
                            AutomationProperties.LiveSetting="Assertive" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Memberships}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding MembershipTypeName}" Width="*" />
                        <DataGridTextColumn Header="Inicio"
                                            Binding="{Binding StartDate}" Width="100" />
                        <DataGridTextColumn Header="Fin"
                                            Binding="{Binding EndDate, TargetNullValue='Abierta'}" Width="100" />
                        <!-- Estado: pill semántico (mismo lenguaje que el encabezado de la ficha) -->
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MembershipDto">
                                    <Border Classes="Pill" Margin="4,0"
                                            Classes.success="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=success}"
                                            Classes.warning="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=warning}"
                                            Classes.danger="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=danger}"
                                            Classes.info="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=info}"
                                            Classes.accent="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=accent}"
                                            Classes.neutral="{Binding Status, Converter={StaticResource StatusTone}, ConverterParameter=neutral}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource EnumEs}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Se reactiva"
                                            Binding="{Binding FreezeEnd, TargetNullValue='—'}" Width="110" />
                        <DataGridTextColumn Header="Visitas"
                                            Binding="{Binding VisitsRemaining, TargetNullValue='∞'}" Width="80" />
                        <DataGridTemplateColumn Header="Acciones" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:MembershipDto">
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                Margin="4,0" VerticalAlignment="Center">
                                        <!-- Congelar: solo en Active. Con texto: un ícono de pausa solo no dice qué hace. -->
                                        <Button Classes="Ghost"
                                                ToolTip.Tip="Congelar: pausa la membresía y corre el vencimiento"
                                                AutomationProperties.Name="Congelar membresía"
                                                IsVisible="{Binding Status,
                                                    Converter={x:Static ObjectConverters.Equal},
                                                    ConverterParameter={x:Static enums:MembershipStatus.Active}}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MemberDetailViewModel)DataContext).OpenFreezeModalCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Pause}" FontSize="14" />
                                                <TextBlock Text="Congelar" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <!-- Reactivar: solo en Frozen. Es la salida del congelamiento, así que va rotulado. -->
                                        <Button Classes="Ghost"
                                                ToolTip.Tip="Reactivar ahora (los días no usados vuelven al cupo del año)"
                                                AutomationProperties.Name="Reactivar membresía"
                                                IsVisible="{Binding Status,
                                                    Converter={x:Static ObjectConverters.Equal},
                                                    ConverterParameter={x:Static enums:MembershipStatus.Frozen}}"
                                                CommandParameter="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MemberDetailViewModel)DataContext).ReactivateMembershipCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Play}" FontSize="14" />
                                                <TextBlock Text="Reactivar" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="IconButton"
                                                ToolTip.Tip="Cancelar membresía"
                                                AutomationProperties.Name="Cancelar membresía"
                                                CommandParameter="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:MemberDetailViewModel)DataContext).CancelMembershipCommand}">
                                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Delete}" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Padding="16,8"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Classes="FormLabel" FontSize="12"
                               Text="{Binding Memberships.Count, StringFormat={}{0} membresía(s)}" />
                </Border>
            </Grid>

            <!-- TAB: Cobros — delega a ChargesView -->
            <ContentControl
                IsVisible="{Binding ActiveTab,
                    Converter={x:Static ObjectConverters.Equal},
                    ConverterParameter={x:Static vm:MemberDetailTab.Charges}}"
                Content="{Binding ChargesVm}" />

            <!-- TAB: Accesos -->
            <DataGrid
                IsVisible="{Binding ActiveTab,
                    Converter={x:Static ObjectConverters.Equal},
                    ConverterParameter={x:Static vm:MemberDetailTab.Access}}"
                ItemsSource="{Binding AccessLogs}"
                IsReadOnly="True"
                AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha/Hora"
                                        Binding="{Binding SwipedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="160" />
                    <DataGridTemplateColumn Header="Resultado" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Result}"
                                           Foreground="{Binding Color}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Motivo denegación"
                                        Binding="{Binding DenialReason, TargetNullValue='—'}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- TAB: Rutinas — el armador del hub, sin buscador de socio -->
            <Grid IsVisible="{Binding ActiveTab,
                Converter={x:Static ObjectConverters.Equal},
                ConverterParameter={x:Static vm:MemberDetailTab.Routines}}">
                <routines:RoutineBuilderView DataContext="{Binding RoutineBuilder}" />
            </Grid>

        </Grid>

        <!-- ── Modal: congelar membresía ───────────────────────────────────── -->
        <ctl:ModalHost Grid.Row="0" Grid.RowSpan="3"
                       IsVisible="{Binding IsFreezeModalOpen}"
                       Content="{Binding FreezeModal}" />

    </Grid>

</UserControl>
