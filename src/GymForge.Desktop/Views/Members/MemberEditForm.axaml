<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Members"
             xmlns:enums="using:GymForge.Domain.Enums"
             x:Class="GymForge.Desktop.Views.Members.MemberEditForm"
             x:DataType="vm:MemberEditViewModel">

    <!-- Modo edición de la pestaña Datos: se le da como DataContext el MemberEditViewModel (DataContext="{Binding Edit}").
         Datos personales + contacto de emergencia + datos médicos (datos de salud: el audit registra el campo, no el valor). -->
    <UserControl.Styles>
        <Style Selector="TextBox, ComboBox, DatePicker">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">

        <Border Classes="Card" Padding="24,20,24,8">
            <StackPanel>
                <TextBlock Text="Editar datos personales" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16">

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Nombre *" />
                        <TextBox x:Name="FirstNameInput" Text="{Binding FirstName}" MaxLength="100"
                                 AutomationProperties.Name="Nombre" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Apellido *" />
                        <TextBox Text="{Binding LastName}" MaxLength="100" AutomationProperties.Name="Apellido" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Tipo documento *" />
                        <ComboBox ItemsSource="{Binding DocumentTypes}" SelectedItem="{Binding DocumentType}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Tipo de documento">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:DocumentType">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumEs}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Número documento *" />
                        <TextBox Text="{Binding DocumentNumber}" MaxLength="20" AutomationProperties.Name="Número de documento" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Email" />
                        <TextBox Text="{Binding Email}" MaxLength="254" Watermark="socio@email.com"
                                 AutomationProperties.Name="Email" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Celular" />
                        <TextBox Text="{Binding Mobile}" MaxLength="30" Watermark="+54 9 11 1234-5678"
                                 AutomationProperties.Name="Celular" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Fecha de nacimiento" />
                        <DatePicker SelectedDate="{Binding BirthDate, Converter={StaticResource DateOnlyOffset}}"
                                    HorizontalAlignment="Stretch" AutomationProperties.Name="Fecha de nacimiento" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Género" />
                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Género">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:Gender">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumEs}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,14"
                              IsChecked="{Binding MarketingConsent}" Content="Acepta comunicaciones" FontSize="13" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="Card" Padding="24,20,24,8">
            <StackPanel>
                <TextBlock Text="Contacto de emergencia" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <StackPanel Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Nombre" />
                        <TextBox Text="{Binding EmergencyName}" MaxLength="100" AutomationProperties.Name="Nombre del contacto de emergencia" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Teléfono" />
                        <TextBox Text="{Binding EmergencyPhone}" MaxLength="30" AutomationProperties.Name="Teléfono del contacto de emergencia" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Vínculo" />
                        <TextBox Text="{Binding EmergencyRelation}" MaxLength="50" Watermark="Ej: Madre"
                                 AutomationProperties.Name="Vínculo del contacto de emergencia" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="Card" Padding="24,20,24,8">
            <StackPanel>
                <TextBlock Text="Datos médicos" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Condiciones médicas" />
                        <TextBox Text="{Binding MedicalConditions}" MaxLength="1000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Condiciones médicas" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Medicación" />
                        <TextBox Text="{Binding Medications}" MaxLength="1000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Medicación" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Alergias" />
                        <TextBox Text="{Binding Allergies}" MaxLength="1000" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="64" AutomationProperties.Name="Alergias" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                        <TextBlock Classes="FormLabel" Text="Grupo sanguíneo" />
                        <ComboBox ItemsSource="{Binding BloodTypes}" SelectedItem="{Binding BloodType}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="Grupo sanguíneo">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="enums:BloodType">
                                    <TextBlock Text="{Binding Converter={StaticResource EnumEs}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Mismo InfoBar de error que el resto de la ficha (Membresías); anuncia el error a lectores de pantalla -->
        <fa:InfoBar IsOpen="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Severity="Error" Title="No se pudo guardar" Message="{Binding ErrorMessage}"
                    IsClosable="False" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,0,0,8">
            <Button Classes="Ghost" Content="Cancelar" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="Guardar" Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
