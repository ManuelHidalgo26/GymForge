<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:GymForge.Desktop.ViewModels.Settings"
             xmlns:views="using:GymForge.Desktop.Views.Settings"
             xmlns:set="using:GymForge.Application.UseCases.Settings"
             xmlns:lic="using:GymForge.Application.UseCases.Licensing"
             x:Class="GymForge.Desktop.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- Medidor de uso del plan (Socios / Sedes). Dentro del tope: barra de acento; si se pasa:
             cifra y barra en tono de aviso + pill "Excede el plan" (no depende solo del color).
             La barra se llena hasta el máximo y no más, así que 60 de 50 se ve completa. -->
        <DataTemplate x:Key="UsageMeter" x:DataType="lic:LicenseUsageLine">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" Classes="FormLabel" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Classes="Numeric"
                               Classes.warning="{Binding OverLimit}">
                        <Run Text="{Binding Used}" /><Run Text=" de " /><Run Text="{Binding Max}" />
                    </TextBlock>
                </Grid>
                <ProgressBar Minimum="0"
                             Maximum="{Binding Max}"
                             Value="{Binding Used}"
                             Height="6" CornerRadius="3"
                             Background="{DynamicResource NeutralTintBrush}"
                             Classes.warning="{Binding OverLimit}"
                             AutomationProperties.Name="{Binding Label, StringFormat='Uso de {0} dentro del plan'}" />
                <Border Classes="Pill warning" IsVisible="{Binding OverLimit}">
                    <TextBlock Text="Excede el plan" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Toolbar ────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Classes="Toolbar">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Settings}" FontSize="20" VerticalAlignment="Center" />
                <TextBlock Text="Configuración" Classes="ToolbarTitle" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Center">

                <!-- ── Datos del gimnasio ─────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Datos del gimnasio" FontSize="15" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nombre / Razón social *" Classes="FormLabel" />
                                <TextBox Text="{Binding LegalName}" Width="320" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="CUIT *" Classes="FormLabel" />
                                <TextBox Text="{Binding TaxId}" Watermark="30-12345678-9" Width="180" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding CompanyMessage}" Classes="Feedback"
                                   Classes.success="{Binding CompanySaved}"
                                   Classes.danger="{Binding !CompanySaved}"
                                   IsVisible="{Binding CompanyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Guardar cambios" Command="{Binding SaveCompanyCommand}" Classes="Primary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ── Seguridad / PIN ────────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Seguridad — PIN de acceso" FontSize="15" FontWeight="SemiBold" />

                        <fa:InfoBar IsOpen="{Binding IsDefaultPinInUse}"
                                    Severity="Warning"
                                    Title="PIN de fábrica activo"
                                    Message="Todavía está activo el PIN de fábrica (1234). Cambialo antes de poner el gimnasio en marcha."
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Polite" />

                        <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                   Text="El PIN se usa para abrir caja e iniciar sesión de cajero. Tiene que tener entre 4 y 8 dígitos." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PIN actual" Classes="FormLabel" />
                                <TextBox Text="{Binding CurrentPin}" PasswordChar="●" MaxLength="8" Width="140" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Nuevo PIN" Classes="FormLabel" />
                                <TextBox Text="{Binding NewPin}" PasswordChar="●" MaxLength="8" Width="140" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Repetir nuevo PIN" Classes="FormLabel" />
                                <TextBox Text="{Binding NewPinConfirm}" PasswordChar="●" MaxLength="8" Width="140" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding PinMessage}" Classes="Feedback"
                                   Classes.success="{Binding PinSaved}"
                                   Classes.danger="{Binding !PinSaved}"
                                   IsVisible="{Binding PinMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Cambiar PIN" Command="{Binding ChangePinCommand}" Classes="Primary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ── Marca ──────────────────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Marca" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                       Text="El logo aparece en el menú y en los recibos. El color de acento pinta botones, íconos y resaltados de toda la app." />
                        </StackPanel>

                        <!-- Logo -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                                <Panel>
                                    <Image Source="{Binding LogoPreview}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasLogoPreview}" />
                                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Image}" FontSize="26"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding !HasLogoPreview}" />
                                </Panel>
                            </Border>
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Command="{Binding PickLogoCommand}" Classes="Secondary">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Upload}" FontSize="14" />
                                            <TextBlock Text="Elegir logo" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Quitar" Classes="Ghost"
                                            Command="{Binding RemoveLogoCommand}"
                                            IsVisible="{Binding HasLogoPreview}" />
                                </StackPanel>
                                <TextBlock Text="PNG o JPG, preferentemente cuadrado." Classes="Caption" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Color de acento -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Color de acento" Classes="FormLabel" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Classes="Swatch" Background="#6366F1" ToolTip.Tip="Indigo"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#6366F1"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#6366F1}" />
                                <Button Classes="Swatch" Background="#2563EB" ToolTip.Tip="Azul"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#2563EB"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#2563EB}" />
                                <Button Classes="Swatch" Background="#059669" ToolTip.Tip="Esmeralda"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#059669"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#059669}" />
                                <Button Classes="Swatch" Background="#7C3AED" ToolTip.Tip="Violeta"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#7C3AED"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#7C3AED}" />
                                <Button Classes="Swatch" Background="#D97706" ToolTip.Tip="Ámbar"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#D97706"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#D97706}" />
                                <Button Classes="Swatch" Background="#DC2626" ToolTip.Tip="Granate"
                                        Command="{Binding SelectAccentCommand}" CommandParameter="#DC2626"
                                        Classes.selected="{Binding BrandColorHex, Converter={StaticResource StringEquals}, ConverterParameter=#DC2626}" />
                                <TextBox Text="{Binding BrandColorHex}" Watermark="#6366F1" Width="110"
                                         VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{Binding BrandMessage}" Classes="Feedback"
                                   Classes.success="{Binding BrandSaved}"
                                   Classes.danger="{Binding !BrandSaved}"
                                   IsVisible="{Binding BrandMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Guardar marca" Command="{Binding SaveBrandingCommand}" Classes="Primary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ── Sedes ──────────────────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Sedes" FontSize="15" FontWeight="SemiBold" />

                        <ItemsControl ItemsSource="{Binding Sites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="set:SiteDto">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <fa:SymbolIcon Grid.Column="0" Symbol="{x:Static fa:Symbol.Home}"
                                                       FontSize="14" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                            <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Address}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </TextBlock>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                            <Button Classes="IconButton" ToolTip.Tip="Modificar sede"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).EditSiteCommand}">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Edit}" FontSize="13" />
                                            </Button>
                                            <Button Classes="IconButton" ToolTip.Tip="Eliminar sede">
                                                <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Delete}" FontSize="13"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                <Button.Flyout>
                                                    <Flyout Placement="BottomEdgeAlignedRight">
                                                        <StackPanel Spacing="8" Width="240">
                                                            <TextBlock Text="¿Eliminar esta sede?" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Classes="FormLabel" FontSize="11" TextWrapping="Wrap"
                                                                       Text="Si tiene socios o movimientos se desactiva (conserva el historial). No se puede eliminar la única sede." />
                                                            <Button Content="Eliminar"
                                                                    Classes="Danger"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    CommandParameter="{Binding}"
                                                                    Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteSiteCommand}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Classes="Divider" />

                        <TextBlock Text="{Binding SiteFormTitle}" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding NewSiteName}" Watermark="Nombre (ej: Sede Sur)" Width="170" />
                            <TextBox Text="{Binding NewSiteAddress}" Watermark="Dirección" Width="220" />
                            <TextBox Text="{Binding NewSitePhone}" Watermark="Teléfono (opcional)" Width="150" />
                            <Button Command="{Binding SaveSiteCommand}" Classes="Secondary">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Save}" FontSize="14" />
                                    <TextBlock Text="Guardar" />
                                </StackPanel>
                            </Button>
                            <Button Content="Cancelar" Classes="Ghost"
                                    IsVisible="{Binding IsEditingSite}"
                                    Command="{Binding CancelSiteEditCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SiteMessage}" Classes="Feedback"
                                   Classes.success="{Binding SiteSaved}"
                                   Classes.danger="{Binding !SiteSaved}"
                                   IsVisible="{Binding SiteMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- ── Comisiones del personal ────────────────────────────── -->
                <views:StaffCommissionsCard DataContext="{Binding Commissions}" />

                <!-- ── Reglas de acceso ───────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Control de acceso" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                   Text="Reglas del molinete/kiosko: cuánto puede deber un socio antes de avisar o bloquear el ingreso, y el tiempo mínimo entre pasadas (anti-passback)." />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Avisar deuda desde" Classes="FormLabel" />
                                <NumericUpDown Value="{Binding WarnOnOweAmount}" Minimum="0" Increment="1000"
                                               FormatString="C0" Width="160" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Bloquear deuda desde" Classes="FormLabel" />
                                <NumericUpDown Value="{Binding StopOnOweAmount}" Minimum="0" Increment="1000"
                                               FormatString="C0" Width="160" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Anti-passback (min)" Classes="FormLabel" />
                                <NumericUpDown Value="{Binding AntiPassbackMinutes}" Minimum="0" Maximum="120"
                                               Increment="1" Width="130" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding AccessMessage}" Classes="Feedback"
                                   Classes.success="{Binding AccessSaved}"
                                   Classes.danger="{Binding !AccessSaved}"
                                   IsVisible="{Binding AccessMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Guardar reglas" Command="{Binding SaveAccessCommand}" Classes="Primary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ── Cobranzas y recordatorios ──────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="16">

                        <StackPanel Spacing="3">
                            <TextBlock Text="Cobranzas y recordatorios" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                       Text="Cómo les avisás a los socios que tienen cuotas vencidas." />
                        </StackPanel>

                        <!-- Aviso automático. La aclaración de que hoy NO envía va en un InfoBar (no en texto
                             tenue): es lo que más se puede malinterpretar al prender el interruptor. -->
                        <StackPanel Spacing="8">
                            <ToggleSwitch IsChecked="{Binding DunningEnabled}"
                                          OnContent="Aviso automático encendido"
                                          OffContent="Aviso automático apagado"
                                          AutomationProperties.Name="Aviso automático de cobranzas" />
                            <fa:InfoBar IsOpen="True"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Title="Hoy el aviso automático no envía mensajes"
                                        Message="Solo deja registro de lo que enviaría. Para avisar por WhatsApp usá el botón Recordar de la pantalla Morosos: funciona siempre, con el aviso automático encendido o apagado." />
                        </StackPanel>

                        <Border Classes="Divider" />

                        <!-- Mensajes por etapa. Orden de tabulación = orden visual: días → nombre → mensaje, etapa por etapa. -->
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Mensajes por etapa" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Son los mismos para el aviso automático y para el botón Recordar de Morosos. Cada etapa se usa a partir de los días de vencido que indiques." />
                            </StackPanel>

                            <!-- Ayuda de datos: lista de dos columnas (dato en monoespaciado + qué es). -->
                            <Border Classes="Inset">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Datos que podés usar en el mensaje" FontSize="12" FontWeight="SemiBold" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                          ColumnSpacing="16" RowSpacing="4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Mono" FontSize="12" FontWeight="SemiBold" Text="{}{nombre}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="FormLabel" Text="Nombre del socio" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Mono" FontSize="12" FontWeight="SemiBold" Text="{}{gimnasio}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="FormLabel" Text="Nombre del gimnasio" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="Mono" FontSize="12" FontWeight="SemiBold" Text="{}{monto}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="FormLabel" Text="Saldo adeudado" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="Mono" FontSize="12" FontWeight="SemiBold" Text="{}{vencimiento}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="FormLabel" Text="Fecha de vencimiento" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Classes="Mono" FontSize="12" FontWeight="SemiBold" Text="{}{dias}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="FormLabel" Text="Días de atraso" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DunningStages}"
                                          AutomationProperties.Name="Etapas de recordatorio">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DunningStageEditor">
                                        <Border Classes="Inset">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Días de vencido" Classes="FormLabel" />
                                                        <NumericUpDown Value="{Binding DaysOverdue}" Minimum="1" Maximum="365"
                                                                       Increment="1" Width="130"
                                                                       AutomationProperties.Name="{Binding Label, StringFormat='Días de vencido de la etapa {0}'}" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="Nombre de la etapa" Classes="FormLabel" />
                                                        <TextBox Text="{Binding Label}" MaxLength="40" Width="240"
                                                                 AutomationProperties.Name="Nombre de la etapa" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Mensaje" Classes="FormLabel" />
                                                    <TextBox Text="{Binding Template}" MaxLength="1000"
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72"
                                                             AutomationProperties.Name="{Binding Label, StringFormat='Mensaje de la etapa {0}'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding DunningMessage}" Classes="Feedback"
                                   Classes.success="{Binding DunningSaved}"
                                   Classes.danger="{Binding !DunningSaved}"
                                   IsVisible="{Binding DunningMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button Content="Guardar cobranzas" Command="{Binding SaveDunningCommand}" Classes="Primary"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ── Licencia ───────────────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="16">

                        <!-- Plan vigente + uso contra los topes. Dentro del plan: barra de acento. Si se pasa
                             (sedes o socios previos a un cambio de plan): cifra, barra y pill de aviso. -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Licencia" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LicensePlanDisplay}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <ContentControl Grid.Column="0" Content="{Binding MembersUsage}"
                                            ContentTemplate="{StaticResource UsageMeter}"
                                            HorizontalContentAlignment="Stretch" />
                            <ContentControl Grid.Column="1" Content="{Binding SitesUsage}"
                                            ContentTemplate="{StaticResource UsageMeter}"
                                            HorizontalContentAlignment="Stretch" />
                        </Grid>

                        <!-- La clave está atada a otra PC: solo avisa, el sistema sigue funcionando igual.
                             Apunta al bloque "Código de esta PC" (más abajo), que es lo que hay que pasarle al proveedor. -->
                        <fa:InfoBar IsOpen="{Binding LicenseMachineMismatch}"
                                    Severity="Warning"
                                    IsClosable="False"
                                    Title="Esta licencia fue emitida para otra PC"
                                    Message="Seguís operando con normalidad. Para que te la vuelvan a emitir para esta PC, pasale a tu proveedor el código de esta PC (más abajo)."
                                    AutomationProperties.LiveSetting="Polite" />

                        <Border Classes="Divider" />

                        <!-- Activar / renovar: el resultado (o el error, p. ej. clave de otro CUIT) queda justo debajo -->
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Activar o renovar licencia" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Pegá la clave de licencia que recibiste al comprar o renovar tu plan." />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0" Text="{Binding LicenseKeyInput}" Watermark="GYMF.…"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Clave de licencia" />
                                <Button Grid.Column="1" Content="Activar" Command="{Binding ActivateLicenseCommand}"
                                        Classes="Primary" VerticalAlignment="Center"
                                        AutomationProperties.Name="Activar licencia" />
                            </Grid>
                            <TextBlock Text="{Binding LicenseMessage}" Classes="Feedback"
                                       Classes.success="{Binding LicenseSaved}"
                                       Classes.danger="{Binding !LicenseSaved}"
                                       IsVisible="{Binding LicenseMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Border Classes="Divider" />

                        <!-- Para licencias atadas a una PC: el gimnasio le dicta este código al proveedor -->
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Código de esta PC" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Si querés que tu licencia quede atada a esta PC, pasale este código a tu proveedor al pedirla." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding ThisPcCodeDisplay, Mode=OneWay}" IsReadOnly="True" Width="260"
                                         Classes="Mono" FontSize="14"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Código de esta PC" />
                                <Button Command="{Binding CopyThisPcCodeCommand}" VerticalAlignment="Center"
                                        AutomationProperties.Name="Copiar el código de esta PC">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Copy}" FontSize="14" />
                                        <TextBlock Text="Copiar" />
                                    </StackPanel>
                                </Button>
                                <!-- Feedback inline de "Copiar": junto al botón, no en el mensaje de activación -->
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            IsVisible="{Binding ThisPcCodeCopied}"
                                            AutomationProperties.LiveSetting="Polite">
                                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Accept}" FontSize="14"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    <TextBlock Text="Copiado" Classes="Feedback success" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Datos: copia de seguridad y migración ──────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Copia de seguridad y migración" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                   Text="Exportar guarda en un solo archivo cifrado todo lo del gimnasio: socios, cobros, caja, rutinas, el logo y las fotos. Sirve de respaldo y para mudar los datos a otra PC; para abrirlo hace falta la frase de acceso del respaldo (más abajo)." />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Exportar datos" Command="{Binding ExportDataCommand}"
                                    Classes="Primary" IsEnabled="{Binding !IsTransferBusy}" />
                            <Button Content="Importar datos…" Command="{Binding ChooseImportFileCommand}"
                                    IsEnabled="{Binding !IsTransferBusy}" />
                        </StackPanel>

                        <!-- Import de un paquete cifrado: primero la frase, para poder abrirlo -->
                        <Border IsVisible="{Binding IsImportPassphraseNeeded}"
                                Background="{DynamicResource WarningTintBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Este paquete está cifrado" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                           Text="Ingresá la frase de acceso del respaldo con la que se exportó." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding ImportPassphrase}" PasswordChar="•"
                                             Watermark="Frase de acceso del respaldo" Width="280"
                                             AutomationProperties.Name="Frase de acceso para abrir el paquete" />
                                    <Button Content="Abrir paquete" Command="{Binding UnlockImportCommand}"
                                            Classes="Primary" IsEnabled="{Binding !IsTransferBusy}" />
                                    <Button Content="Cancelar" Command="{Binding CancelImportCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Confirmación del import: resumen del paquete + PIN -->
                        <Border IsVisible="{Binding IsImportPending}"
                                Background="{DynamicResource WarningTintBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Vas a reemplazar todos los datos actuales"
                                           FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ImportSummary}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Classes="FormLabel" FontSize="12" TextWrapping="Wrap"
                                           Text="Se guarda una copia de los datos actuales antes de reemplazarlos. Al terminar, GymForge se reinicia." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Text="{Binding ImportPin}" PasswordChar="•"
                                             Watermark="PIN de administrador" Width="200" />
                                    <Button Content="Reemplazar datos" Command="{Binding ConfirmImportCommand}"
                                            Classes="Primary" IsEnabled="{Binding !IsTransferBusy}" />
                                    <Button Content="Cancelar" Command="{Binding CancelImportCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DataMessage}" Classes="Feedback"
                                   Classes.success="{Binding DataOk}"
                                   Classes.danger="{Binding !DataOk}"
                                   IsVisible="{Binding DataMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   AutomationProperties.LiveSetting="Polite" />

                        <Border Classes="Divider" />

                        <!-- Frase de acceso del respaldo: cifra lo que sale de la PC. Nunca se muestra, solo se fija. -->
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Frase de acceso del respaldo" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Border Classes="Pill success" IsVisible="{Binding HasBackupPassphrase}">
                                        <TextBlock Text="Configurada ✓" />
                                    </Border>
                                    <Border Classes="Pill warning" IsVisible="{Binding !HasBackupPassphrase}">
                                        <TextBlock Text="Sin configurar" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Todo lo que sale de esta PC (la copia externa y el archivo exportado) viaja cifrado con esta frase. Si la perdés, esos respaldos no se pueden recuperar: no hay forma de resetearla. Guardala aparte, no en el mismo pendrive. Es distinta del PIN." />
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="{Binding BackupPassphraseMinLength, StringFormat='Mínimo {0} caracteres. Cambiarla no afecta a los respaldos ya hechos: esos se abren con la frase que tenían.'}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding PassphraseInput}" PasswordChar="•"
                                         Watermark="Frase nueva" Width="220"
                                         AutomationProperties.Name="Frase de acceso nueva" />
                                <TextBox Text="{Binding PassphraseConfirm}" PasswordChar="•"
                                         Watermark="Repetir la frase" Width="220"
                                         AutomationProperties.Name="Repetir la frase de acceso" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding PassphrasePin}" PasswordChar="•"
                                         Watermark="PIN de administrador" Width="220" />
                                <Button Content="{Binding BackupPassphraseActionText}"
                                        Command="{Binding SetBackupPassphraseCommand}" Classes="Primary" />
                            </StackPanel>

                            <TextBlock Text="{Binding PassphraseMessage}" Classes="Feedback" TextWrapping="Wrap"
                                       Classes.success="{Binding PassphraseOk}"
                                       Classes.danger="{Binding !PassphraseOk}"
                                       IsVisible="{Binding PassphraseMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Border Classes="Divider" />

                        <!-- Copia de seguridad externa: pendrive, carpeta de red o carpeta sincronizada.
                             Carpeta (campo de solo lectura, enfocable y copiable) → estado (pill + detalle) → acción. -->
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Copia de seguridad externa" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                           Text="Cada resguardo que hace GymForge (al abrir el día y al cerrar caja) también se copia a esta carpeta, así los datos sobreviven a que se rompa el disco de esta PC. Puede ser un pendrive, una carpeta de red o una carpeta sincronizada: la copia viaja cifrada con tu frase de acceso. Guardá la frase aparte del pendrive o la carpeta: si la perdés, el respaldo no se puede recuperar." />
                            </StackPanel>

                            <!-- Carpeta de destino. El TextBox muestra la ruta completa (scrollea) y el tooltip la repite. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding OffsiteBackupDir, Mode=OneWay}" IsReadOnly="True"
                                         Watermark="Sin carpeta elegida"
                                         VerticalAlignment="Center"
                                         ToolTip.Tip="{Binding OffsiteBackupDirDisplay}"
                                         AutomationProperties.Name="Carpeta de la copia de seguridad externa" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding PickOffsiteFolderCommand}"
                                            AutomationProperties.Name="Elegir carpeta para la copia de seguridad externa">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Folder}" FontSize="14" />
                                            <TextBlock Text="Elegir carpeta…" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Quitar" Classes="Ghost" Command="{Binding ClearOffsiteCommand}"
                                            IsVisible="{Binding HasOffsiteBackupDir}"
                                            AutomationProperties.Name="Quitar la carpeta de la copia de seguridad externa" />
                                </StackPanel>
                            </Grid>

                            <!-- Estado: pill con tono + detalle (último resguardo / qué falla).
                                 Sin carpeta = neutral; con carpeta = "Al día" o "Requiere atención".
                                 Los dos últimos se anidan en un contenedor visible solo con carpeta elegida. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Panel Grid.Column="0" VerticalAlignment="Top">
                                    <Border Classes="Pill neutral" IsVisible="{Binding !HasOffsiteBackupDir}">
                                        <TextBlock Text="Sin configurar" />
                                    </Border>
                                    <StackPanel IsVisible="{Binding HasOffsiteBackupDir}">
                                        <Border Classes="Pill warning" IsVisible="{Binding OffsiteNeedsAttention}">
                                            <TextBlock Text="Requiere atención" />
                                        </Border>
                                        <Border Classes="Pill success" IsVisible="{Binding !OffsiteNeedsAttention}">
                                            <TextBlock Text="Al día" />
                                        </Border>
                                    </StackPanel>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding OffsiteStatusDisplay}"
                                           Classes="FormLabel Numeric" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Command="{Binding BackupOffsiteNowCommand}" Classes="Secondary"
                                        AutomationProperties.Name="Copiar ahora el resguardo a la carpeta externa">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Sync}" FontSize="14" />
                                        <TextBlock Text="Copiar ahora" />
                                    </StackPanel>
                                </Button>
                                <!-- Mientras copia (un pendrive o una red lenta puede tardar): fuera del botón,
                                     que queda deshabilitado, para que el aviso se lea con contraste pleno. -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                            IsVisible="{Binding BackupOffsiteNowCommand.IsRunning}">
                                    <fa:ProgressRing Width="16" Height="16" />
                                    <TextBlock Text="Copiando…" Classes="FormLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding OffsiteMessage}" Classes="Feedback"
                                       Classes.success="{Binding OffsiteOk}"
                                       Classes.danger="{Binding !OffsiteOk}"
                                       IsVisible="{Binding OffsiteMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Versión y actualizaciones ──────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Versión y actualizaciones" FontSize="15" FontWeight="SemiBold" />

                        <!-- Versión instalada. El pill aparece cuando ya hay una versión nueva descargada
                             (sigue visible aunque se haya elegido "Después" en el aviso del shell). -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Versión instalada" Classes="FormLabel" />
                                <TextBlock Text="{Binding Updates.CurrentVersion}"
                                           FontSize="18" FontWeight="SemiBold" Classes="Numeric" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="Pill info"
                                    IsVisible="{Binding Updates.IsUpdateReady}">
                                <TextBlock Text="Actualización lista" />
                            </Border>
                        </Grid>

                        <StackPanel Spacing="8">
                            <Button Command="{Binding Updates.CheckCommand}" Classes="Secondary"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding !Updates.IsChecking}"
                                    AutomationProperties.Name="Buscar actualizaciones">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <fa:ProgressRing IsVisible="{Binding Updates.IsChecking}" Width="16" Height="16" />
                                    <fa:SymbolIcon Symbol="{x:Static fa:Symbol.Sync}" FontSize="14"
                                                   IsVisible="{Binding !Updates.IsChecking}" />
                                    <TextBlock Text="Buscar actualizaciones" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding Updates.StatusMessage}" Classes="FormLabel" TextWrapping="Wrap"
                                       IsVisible="{Binding Updates.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Border Classes="Divider" />

                        <!-- Origen editable (https o carpeta); cambiarlo pide el PIN de administrador. -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Origen de las actualizaciones" Classes="FormLabel" />
                            <TextBox Text="{Binding UpdateFeedInput}" Classes="Mono" FontSize="12"
                                     Watermark="https://… o \\servidor\carpeta (vacío = el de fábrica)"
                                     AutomationProperties.Name="Origen de las actualizaciones" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Text="{Binding UpdateFeedPin}" PasswordChar="•"
                                         Watermark="PIN de administrador" Width="220"
                                         AutomationProperties.Name="PIN de administrador para guardar el origen" />
                                <Button Content="Guardar origen" Command="{Binding SaveUpdateFeedCommand}"
                                        Classes="Primary" />
                            </StackPanel>
                            <TextBlock Classes="FormLabel" TextWrapping="Wrap"
                                       Text="{Binding UpdateFeedDisplay, StringFormat='En uso: {0}'}" />
                            <TextBlock Text="{Binding UpdateFeedMessage}" Classes="Feedback" TextWrapping="Wrap"
                                       Classes.success="{Binding UpdateFeedSaved}"
                                       Classes.danger="{Binding !UpdateFeedSaved}"
                                       IsVisible="{Binding UpdateFeedMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Info del sistema ───────────────────────────────────── -->
                <Border Classes="Card" Padding="24">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Sistema" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="FormLabel" FontSize="12"
                                   Text="Los datos se guardan localmente en esta PC (%LOCALAPPDATA%\GymForge). Moneda: ARS · Zona horaria: Argentina (UTC-3)."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>

</UserControl>
